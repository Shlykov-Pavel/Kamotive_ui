{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["dom", "es6", "es2016", "es2017"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "jsx": "react",
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "typeRoots": ["./types", "./node_modules/@types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "src/types/*.d.ts"],
  "exclude": ["node_modules", "dist", "**/*.stories.*"]
}
